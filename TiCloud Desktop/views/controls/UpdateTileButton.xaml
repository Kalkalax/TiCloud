<UserControl x:Class="TiCloud_Desktop.views.controls.UpdateTileButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:models="clr-namespace:TiCloud.Core.Database.Models"   
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             Height="72" 
             Width="380">


    <Grid>
        <!--Podział widoku na wiersze-->
        <Grid.RowDefinitions>
            <RowDefinition Height="10"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="17"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="10"/>

        </Grid.RowDefinitions>

        <!--Podział widoku na kolumny-->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="52"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="15"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>

        <!--Tło przycisku-->
        <Border 
            Background="#FFFEFEFF" 
            CornerRadius="15,15,15,15" 
            Grid.RowSpan="9" 
            Grid.ColumnSpan="9"
                
        />

        <!--Tło ikony aktualizacji-->
        <Border
            Background="#FF0D0D0D" 
            CornerRadius="7,7,7,7"
            Grid.Column="1"
            Grid.Row="1"
            Grid.RowSpan="4">

            <svg:SvgViewbox 
                Source="{Binding IconName, StringFormat='/resources/images/{0}.svg', RelativeSource={RelativeSource AncestorType=UserControl}}"
                Width="34" 
                Height="34" 
            />

        </Border>

        <!--Ikona wersji-->
        <svg:SvgViewbox 
            Source="/resources/images/version_icon.svg" 
            Width="14" 
            Height="14" 
                 
            Grid.Column="3"
            Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
        />

        <TextBlock 
            Text="{Binding Version, FallbackValue='2.0.0', RelativeSource={RelativeSource AncestorType=UserControl}}"   
            Foreground="#E5343435" 
            Grid.Column="5" 
            Grid.Row="2" 
            VerticalAlignment="Center" 
            HorizontalAlignment="Left" 
            Height="15" Width="50"
            FontFamily="pack://application:,,,/resources/fonts/#PT Sans" FontWeight="Bold" UseLayoutRounding="True" Padding="0,0,0,2" ScrollViewer.CanContentScroll="True" LineStackingStrategy="BlockLineHeight"
        />

        <TextBlock 
             Text="{Binding Text, FallbackValue='First version of the application ', RelativeSource={RelativeSource AncestorType=UserControl}}"
             Foreground="#E50D0D0D"
             FontFamily="Alef" 
             Grid.Column="3" 
             Grid.ColumnSpan="3"
             Grid.Row="3" FontSize="13.5" FontWeight="Regular" UseLayoutRounding="False" Padding="0,2,0,0" 
             
        />

        <TextBlock 
             Text="{Binding Date, FallbackValue='test', RelativeSource={RelativeSource AncestorType=UserControl}}"
             Foreground="#7F343435"
             FontFamily="Alef" 
             Grid.Column="5"
             Grid.Row="1" 
             Margin="192,0,0,0" 
             HorizontalAlignment="Right" 
             Width="86" 
             TextAlignment="Right" 
             FontWeight="Bold" 
             Height="10" FontSize="10" 
     
        />

        <Button Template="{DynamicResource ButtonTemplate1}"  
            Style="{DynamicResource UpdateTileButton.xaml}" 
            Click="Button_Click"
            Background="#00808080" 
            BorderBrush="#00707070" 
            Foreground="#00000000" 
            BorderThickness="0,0,0,0" 
            FontFamily="Rockwell" Grid.ColumnSpan="7" Grid.RowSpan="6"
        />

    </Grid>
</UserControl>
