<UserControl x:Class="TiCloud_Desktop.views.controls.DatabaseProjectsTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TiCloud_Desktop.views.controls"
             xmlns:custom="clr-namespace:TiCloud_Desktop.views.controls"
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             mc:Ignorable="d" 
             d:DesignHeight="31" d:DesignWidth="380">
    <Grid>

        <Button 
            Style="{DynamicResource DatabaseProjectsTileButton.xaml}"    
            Grid.Column="0"
            Width="380"
            Height="31"

            >
            <Grid>
                <TextBlock 
                    Text="{Binding ProjectName, FallbackValue='Praca nad TiCloud Desktop', RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Width="156" 
                    Height="23"
                    Margin="0,0,222,0" 
                    FontFamily="Alef" 
                    Padding="15,6,0,0" 
                    FontSize="11" 
                    Foreground="#FF353535"
                />
                <Line 
                    Margin="156,3,221,3" 
                    Fill="#FFF2F2F2" 
                    Y2="23" 
                    Stroke="#FFF2F2F2"
                />
                <TextBlock 
                    Text="{Binding ProjectID, FallbackValue='6779c498e16b4f0079dc7261', RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Width="156" 
                    Height="23"
                    Margin="157,3,65,3" 
                    FontFamily="Alef" 
                    Padding="0,6,0,0" 
                    FontSize="11" 
                    Foreground="#FF353535" TextAlignment="Center" 
                />
                <Line 
                    Margin="313,3,64,3" 
                    Fill="#FFF2F2F2" 
                    Y2="23" 
                    Stroke="#FFF2F2F2"
                />

                <Border 
                    Margin="318,1,33,1" 
                    CornerRadius="13,13,13,13" 
                    BorderBrush="#FFF2F2F2" 
                    BorderThickness="1,1,1,1" 
                    Width="27" 
                    Height="27"
                    >
                    <svg:SvgViewbox Width="17" Height="17" Opacity="0.6"/>
                    
                </Border>

                <Button 
                    Style="{DynamicResource DatabaseProjectsTileOption.xaml}"    
                    Margin="350,1,1,1" 
                    Width="27" 
                    Height="27" 
                    Click="Button_Click"
                    
                    >


                    <svg:SvgViewbox Source="/resources/images/play_icon.svg" Width="17" Height="17" Opacity="0.6" Margin="2,0,0,0"/>
                </Button>


            </Grid>
        </Button>
        






    </Grid>
</UserControl>
