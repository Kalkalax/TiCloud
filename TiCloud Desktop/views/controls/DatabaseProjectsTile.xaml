<UserControl x:Class="TiCloud_Desktop.views.controls.DatabaseProjectsTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TiCloud_Desktop.views.controls"
             mc:Ignorable="d" 
             d:DesignHeight="31" d:DesignWidth="380">
    <Grid>

        <Border 
            Grid.Column="0"
            Width="380"
            Height="31"
            
            CornerRadius="15"
            Background="#FFF2F2F2" 
            BorderBrush="#FF343435" 
            BorderThickness="1" 
            >
            <Grid>
                <TextBlock 
                    Text="Project name"
                    Width="156" 
                    Height="23"
                    Margin="0,0,222,0" 
                    FontFamily="Alef" 
                    FontWeight="DemiBold" 
                    Padding="44,4,0,0" 
                    FontSize="13" 
                    Foreground="#FF353535" 
                />
                <Line 
                    Margin="156,3,221,3" 
                    Fill="#FFFEFEFE" 
                    Y2="23" 
                    Stroke="#FFFEFEFE"
                />
                <TextBlock 
                    Text="Identificator"
                    Width="156" 
                    Height="23"
                    Margin="157,3,65,3" 
                    FontFamily="Alef" 
                    FontWeight="DemiBold" 
                    Padding="42,4,0,0" 
                    FontSize="13" 
                    Foreground="#FF353535" 
                />
                <Line 
                    Margin="313,3,64,3" 
                    Fill="#FFFEFEFE" 
                    RenderTransformOrigin="0.87,0.516" 
                    Y2="23" 
                    Stroke="#FFFEFEFE"
                />
                <TextBlock 
                    Text="Option" 
                    Height="23"
                    FontFamily="Alef" 
                    FontWeight="DemiBold" 
                    Padding="10,4,0,0" 
                    Margin="314,3,0,3" 
                    FontSize="13" 
                    Foreground="#FF353535" 
                />

            </Grid>
        </Border>







    </Grid>
</UserControl>
